{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillCatalog",
  "type": "object",
  "required": ["version", "skills"],
  "properties": {
    "version": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "group", "path", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "group": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "license": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
